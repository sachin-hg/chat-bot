# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433          # PgBouncer port — app connects here, not 5432
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=          # FILL IN

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=chat-db-writer

# ── Anthropic (SLM + LLM — both stages use Haiku or Sonnet) ──────────────
ANTHROPIC_API_KEY=          # FILL IN

# ── LangSmith observability ───────────────────────────────────────────────
# Get your API key at https://smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING_V2=true to enable. Works for both the server and
# `make dry-run` — every pipeline turn appears as a trace with all 19 node
# spans, SLM prompts/outputs, tool calls, SSE event counts, and latencies.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=          # ls__... from smith.langchain.com
LANGCHAIN_PROJECT=housing-bot-local

# ── Application ───────────────────────────────────────────────────────────
BOT_ENV=dev                 # mock | dev | local | staging | production
LOG_LEVEL=INFO
APP_PORT=8001               # change if 8001 is taken (make run uses this)
SECRET_KEY=                 # FILL IN — used for session token integrity checks

# ── Housing login service (validates auth_token from FE cookie) ───────────
LOGIN_SERVICE_URL=          # FILL IN — internal Housing auth endpoint

# ── External data APIs (all behind VPN in non-mock envs) ─────────────────
KHOJ_BASE_URL=              # Property search index
ODIN_BASE_URL=              # Locality, project, ratings data
CASA_BASE_URL=              # Rent/resale listing detail
VENUS_BASE_URL=             # New-launch project data (floor plans, gallery, etc.)
AUTOSUGGEST_BASE_URL=       # Entity resolution (locality / project name → UUID)
GANDALF_BASE_URL=           # Price trends, transaction history
REGIONS_BASE_URL=           # Travel time / distance
DATA_BASE_URL=              # Filter suggestions, collections, recently viewed
SEO_BASE_URL=               # SEO content (top societies)
USER_ACTIVITY_BASE_URL=     # Saved properties, recent searches, search alerts

# ── LLM concurrency ───────────────────────────────────────────────────────
LLM_MAX_CONCURRENT=20       # Max parallel Anthropic calls; 120 in production
LLM_QUEUE_MAX=50
LLM_QUEUE_MAX_WAIT_MS=8000  # How long a queued request waits for a slot before 429
